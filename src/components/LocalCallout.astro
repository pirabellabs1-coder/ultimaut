---
// Encart « atelier local » pour les pages de trafic informationnel (codes défaut, blog).
// But : transformer les lecteurs du Grand Ouest en appels, sans tromper ceux qui sont hors zone.
import site from '../data/site.json';
import { WA_PATH } from '../lib/ui.js';
import { LISTE_COURTE } from '../lib/zones.js';

const { sujet = '', waText = 'Bonjour Ultimauto, j\'ai un souci sur mon véhicule.', origine = 'encart_local' } = Astro.props;
const note = String(site.googleRating).replace('.', ',');
const waLink = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(waText)}`;
const titre = `${sujet || 'Voyant allumé'} ? On s'en occupe près de chez vous`;
---
<aside class="my-8 overflow-hidden rounded-2xl border-2 border-brand bg-brand-50" aria-label="Diagnostic à Cholet et service mobile" data-origine={origine}>
  <div class="flex flex-col gap-4 p-5 sm:p-6">
    <div>
      <p class="text-xs font-bold uppercase tracking-wider text-brand-700">Vous habitez dans le {LISTE_COURTE}&#8239;?</p>
      <p class="mt-1.5 font-display text-xl font-extrabold leading-snug text-ink">{titre}</p>
      <p class="mt-2 text-sm leading-relaxed text-ink-700">Diagnostic électronique et devis gratuits à l'atelier de Cholet (49) ou en service mobile, à domicile ou au travail. Noté {note}/5 sur {site.googleReviewCount} avis Google.</p>
    </div>
    <div class="flex flex-col gap-2 sm:flex-row">
      <a href={`tel:${site.phone}`} class="btn-primary whitespace-nowrap sm:flex-[3]">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z" /></svg>
        Appeler le {site.phoneDisplay}
      </a>
      <a href={waLink} target="_blank" rel="noopener" class="btn-whatsapp sm:flex-[2]">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true"><path d={WA_PATH} /></svg>
        WhatsApp
      </a>
    </div>
    <p class="text-xs text-ink-500">Hors de ces départements&#160;? Nous ne pouvons pas intervenir, mais cette page vous aide à comprendre la panne avant de voir un garage près de chez vous.</p>
  </div>
</aside>
