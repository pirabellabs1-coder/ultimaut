---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import MapBlock from '../components/MapBlock.astro';
import ZoneCheck from '../components/ZoneCheck.astro';
import { WA_PATH } from '../lib/ui.js';
import { breadcrumb } from '../lib/jsonld.js';
import { LISTE_COURTE, LISTE_LONGUE } from '../lib/zones.js';

const waLink = `https://wa.me/${site.whatsapp}`;
const url = new URL('/prise-de-rendez-vous', site.url).href;
const jsonLd = [breadcrumb([{ name: 'Accueil', url: site.url }, { name: 'Prise de rendez-vous', url }])];

const etapes = [
  { t: 'Vérifiez votre département', d: `Nous n'intervenons que dans le ${LISTE_COURTE}. C'est la première chose à confirmer avant de réserver.` },
  { t: 'Choisissez un créneau', d: 'Sélectionnez le jour et l\'heure qui vous arrangent directement dans le calendrier en ligne.' },
  { t: 'On confirme', d: 'On vous recontacte pour valider la prestation adaptée à votre véhicule et le tarif (devis gratuit).' },
  { t: 'Intervention', d: 'À l\'atelier de Cholet ou chez vous via le service mobile, selon votre choix.' },
];

// Encadrés « à savoir avant de réserver »
const aSavoir = [
  {
    t: 'Zone d\'intervention',
    d: `Uniquement ${LISTE_LONGUE}. En dehors de ces cinq départements, nous ne prenons pas de rendez-vous.`,
  },
  {
    t: 'Ce qu\'il faut préparer',
    d: 'Marque, modèle, motorisation, kilométrage et, si vous l\'avez, le code défaut affiché. Cela nous permet de confirmer la prestation et le tarif.',
  },
  {
    t: 'Atelier ou service mobile',
    d: 'Vous choisissez : à l\'atelier du 1 Imp. de la Haie à Cholet, ou chez vous / sur votre lieu de travail dans la zone couverte.',
  },
  {
    t: 'Devis gratuit',
    d: 'Le diagnostic et le devis sont gratuits et sans engagement. Le rendez-vous ne vous engage à rien.',
  },
];
---
<Layout
  title="Prendre rendez-vous — Ultimauto Cholet | Devis gratuit"
  description="Réservez en ligne votre décalaminage, nettoyage FAP, reprogrammation ou AdBlue chez Ultimauto à Cholet. Calendrier en ligne, devis gratuit, service mobile."
  jsonLd={jsonLd}
  ogImage="/img/photo-2.jpg"
>
  <section class="relative overflow-hidden bg-cover bg-center" style="background-image: linear-gradient(180deg, rgba(25,106,213,0.82) 0%, rgba(21,101,192,0.93) 100%), url('/img/photo-2.jpg');">
    <div class="mx-auto max-w-[1180px] px-6 py-14 text-white md:py-20">
      <nav aria-label="Fil d'Ariane" class="text-sm text-white/75"><a href="/" class="hover:text-white">Accueil</a> <span class="px-1.5">/</span> <span class="text-white">Prise de rendez-vous</span></nav>
      <h1 class="mt-4 text-4xl font-extrabold text-white [text-shadow:0_2px_18px_rgba(0,0,0,0.35)] md:text-5xl">Prendre rendez-vous</h1>
      <p class="mt-4 max-w-2xl text-lg text-white/90">Réservez votre créneau en quelques clics. Avant tout, indiquez votre département&#160;: nous intervenons uniquement dans le <strong class="text-white">{LISTE_COURTE}</strong>. Besoin d'un conseil avant&#8239;? WhatsApp est le plus rapide (photos et vidéos bienvenues).</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={waLink} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full bg-whatsapp px-6 py-3 font-bold text-white"><svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor"><path d={WA_PATH} /></svg>Écrire sur WhatsApp</a>
        <a href={`tel:${site.phone}`} class="inline-flex items-center gap-2 rounded-full border-2 border-white/40 px-6 py-3 font-semibold text-white hover:bg-white/10">{site.phoneDisplay}</a>
      </div>
    </div>
  </section>

  <!-- Étape 1 : département (débloque le calendrier) -->
  <ZoneCheck variant="full" bg="bg-cloud" gate={true} />

  <!-- Agenda Google (rendez-vous) — masqué tant que le département n'est pas confirmé -->
  <section class="section bg-white" data-zone-gated>
    <div class="mx-auto max-w-[900px] px-6">
      <div class="text-center">
        <span class="eyebrow">Étape 2 — réservation en ligne</span>
        <h2 class="mt-2 text-2xl font-extrabold md:text-3xl">Choisissez votre créneau</h2>
        <p class="mt-3 text-ink-700">Sélectionnez la date et l'heure qui vous conviennent. Vous recevrez une confirmation immédiate.</p>
      </div>
      <div class="mt-8 overflow-hidden rounded-3xl border border-line bg-white shadow-[var(--shadow-soft)]">
        <iframe
          src={site.rendezVous.embed}
          title="Prendre rendez-vous avec Ultimauto"
          loading="lazy"
          class="block h-[700px] w-full border-0"
        ></iframe>
      </div>
      <p class="mt-3 text-center text-sm text-ink-500">Le calendrier ne s'affiche pas&#8239;? <a href={site.rendezVous.lien} target="_blank" rel="noopener" data-rdv-externe class="font-semibold text-brand underline">Ouvrez-le dans un nouvel onglet</a>.</p>
    </div>
  </section>

  <!-- Étapes -->
  <section class="section bg-cloud">
    <div class="mx-auto max-w-[1180px] px-6">
      <div class="mx-auto max-w-2xl text-center">
        <span class="eyebrow">Comment ça se passe</span>
        <h2 class="mt-2 text-2xl font-extrabold md:text-3xl">Simple et rapide</h2>
      </div>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {etapes.map((e, i) => (
          <div class="rounded-2xl border border-line bg-white p-6">
            <span class="grid h-11 w-11 place-items-center rounded-full bg-brand font-display text-lg font-extrabold text-white">{i + 1}</span>
            <h3 class="mt-4 font-bold">{e.t}</h3>
            <p class="mt-2 text-sm text-ink-700">{e.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- À savoir avant de réserver -->
  <section class="section bg-white">
    <div class="mx-auto max-w-[1180px] px-6">
      <div class="mx-auto max-w-2xl text-center">
        <span class="eyebrow">À savoir avant de réserver</span>
        <h2 class="mt-2 text-2xl font-extrabold md:text-3xl">Quatre points à vérifier</h2>
        <p class="mt-3 text-ink-700">Un créneau réservé hors de notre zone d'intervention ne peut pas être honoré&#160;: merci de vérifier ce premier point avant de réserver.</p>
      </div>
      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        {aSavoir.map((c) => (
          <div class="rounded-2xl border border-line bg-cloud p-6">
            <h3 class="flex items-start gap-2.5 font-bold">
              <svg viewBox="0 0 24 24" class="mt-0.5 h-5 w-5 shrink-0 text-brand" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m8.5 12 2.5 2.5 4.5-5"/></svg>
              {c.t}
            </h3>
            <p class="mt-2 text-sm text-ink-700">{c.d}</p>
          </div>
        ))}
      </div>
      <p class="mt-8 text-center text-sm text-ink-500">
        Un doute sur votre commune&#8239;? <a href="/zones-d-intervention" class="font-semibold text-brand underline">Consultez la liste des villes desservies</a>.
      </p>
    </div>
  </section>

  <!-- Carte -->
  <MapBlock bg="bg-cloud" />

  <script is:inline>
    // L'agenda Google est servi dans une iframe : la confirmation de réservation
    // se joue chez Google et n'est pas observable depuis la page. On suit donc
    // l'intention forte : l'ouverture du calendrier dans un nouvel onglet.
    document.querySelectorAll('[data-rdv-externe]').forEach(function (a) {
      a.addEventListener('click', function () {
        if (window.gtag) gtag('event', 'prise_de_rendez_vous', { event_category: 'rdv', event_label: 'google_agenda_onglet' });
      });
    });
  </script>
</Layout>
