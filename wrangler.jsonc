// Configuration Cloudflare Worker d'ultimauto.fr (Worker + fichiers statiques Astro).
// Build : `npm run build` (dist/) ; local : `npm run cf:dev` ; prod : `npm run cf:deploy`.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ultimauto",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // URLs sans slash final : /contact sert dist/contact/index.html (pas de redirection vers /contact/).
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // Le Worker passe en premier partout (redirections, maintenance, géo-blocage),
    // sauf pour les assets fingerprintés et les images, servis directement (aucune requête Worker facturée).
    "run_worker_first": ["/*", "!/_astro/*", "!/img/*"]
  },
  // Flag "maintenance" ("true"/"false"). Namespace "ultimauto-flags", créé au premier déploiement.
  "kv_namespaces": [{ "binding": "FLAGS", "id": "9b77eb5c4ee8477bac4c2e14c2ff1816" }],
  // Limites de débit par IP (anti-spam du formulaire, anti-force brute de la clé /pilote).
  "ratelimits": [
    { "name": "CONTACT_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "MAINTENANCE_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  // Domaines de production (Custom Domains : Cloudflare gère DNS + certificat). www redirige vers l'apex dans le Worker.
  "routes": [
    { "pattern": "ultimauto.fr", "custom_domain": true },
    { "pattern": "www.ultimauto.fr", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false
}
